# =============================================================================
# DocuGuard AI — .gitignore
# React + Vite | Node.js + Express | Python FastAPI
# =============================================================================

# ── Environment / Secrets ─────────────────────────────────────────────────────
# Never commit .env files — they contain secrets (JWT secret, DB URI, API keys)
.env
.env.*
!.env.example
!.env.sample

# ── Node.js / npm ─────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
package-lock.json
.npm/
.npx/

# ── Vite / React Build ─────────────────────────────────────────────────────────
dist/
dist-ssr/
*.local

# ── Python ────────────────────────────────────────────────────────────────────
# Virtual environments
python-ai/venv/
python-ai/.venv/
venv/
.venv/
env/
.env/
ENV/

# Python bytecode cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# pytest cache and results
.pytest_cache/
.cache/
*.pytest_cache
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
*.coveragerc

# ── AI Model Weights ──────────────────────────────────────────────────────────
# Model weights are large binary files — distribute separately
python-ai/weights/
*.pth
*.pt
*.onnx
*.h5
*.pkl
*.bin
*.safetensors

# ── Uploaded Documents ────────────────────────────────────────────────────────
# Uploaded user files should NOT be pushed to git
backend/uploads/

# ── AI Backup (auto-generated during reset) ───────────────────────────────────
ai_backup_*/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.fleet/
*.code-workspace

# ── Temporary / Misc ──────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
.cache/
tmp/
temp/
